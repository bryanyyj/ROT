# Copy to apps/server/.env and fill in. Never commit .env.

# ---- LLM via OpenRouter (required for the AI coach chat/plan) ----
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model from https://openrouter.ai/models. Slugs ending in ":free" are free-tier.
# Free slugs change often — verify at https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
# Cost guard: by default only ":free" models are allowed (zero spend). To permit paid
# models, set OPENROUTER_ALLOW_PAID=true.
# OPENROUTER_ALLOW_PAID=false

# ---- Strava (optional: real activity data) ----
# Create an app at https://www.strava.com/settings/api
# Set the app's "Authorization Callback Domain" to: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8787/api/strava/callback

# ---- Server ----
PORT=8787
WEB_ORIGIN=http://localhost:5173

# Garmin Connect: not self-serve (requires Developer Program approval). Use Strava or
# file import for now; Intervals.icu is a fast alternative for Garmin-sourced data.
